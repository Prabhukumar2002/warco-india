# Copy this file to .env in the server/ folder and fill in real values.
# (server/.env is already git-ignored.)

# PostgreSQL connection string
DATABASE_URL=postgresql://warco_user:hMXYRmicyfDx38FvFx17tBFCyL4gaMN5@dpg-d9sakl2fngtc73eupl3g-a.virginia-postgres.render.com/warco_india

# Secret used to sign login sessions — set this to a long random string in production
JWT_SECRET=change-this-to-a-long-random-string

# Optional: restrict the /admin login endpoint to specific IP addresses.
# A MAC address is never visible to a website (it never leaves your router),
# so it cannot be checked here — IP address is the closest real equivalent.
# Leave unset to allow login attempts from anywhere (still protected by
# username + password). Comma-separated, no spaces.
ALLOWED_LOGIN_IPS=127.0.0.1,::1

PORT=5000

# ---------------------------------------------------------------------------
# Training-booking notifications (optional but recommended)
# ---------------------------------------------------------------------------
# Email: run `npm install nodemailer` inside server/, then fill these in.

NOTIFY_EMAIL_TO=warcoindia@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=warcoindia@gmail.com
SMTP_PASS=your-gmail-app-password

# WhatsApp / SMS via Twilio (optional — needs a paid Twilio account; run
# `npm install twilio` inside server/ first).
# TWILIO_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# NOTIFY_WHATSAPP_TO=whatsapp:+91XXXXXXXXXX
